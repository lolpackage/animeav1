{
  "id": "animeav1",
  "name": "AnimeAV1",
  "version": "1.7.0",
  "apiVersion": 7,
  "entry": "plugin.js",
  "description": "Anime en español latino (y subtitulado si no hay) desde animeav1.com, con inicio, géneros y descubrir. Prueba Voe, UPNShare, MP4Upload, YourUpload y StreamTape y te deja elegir entre los que funcionan.",
  "author": "Jostin Santos",
  "icon": "icon.png",
  "color": "#8E6BFF",
  "theme": {
    "accent": "#8E6BFF"
  },
  "section": {
    "label": "AnimeAV1"
  },
  "categories": [
    "anime"
  ],
  "capabilities": [
    "home",
    "discover",
    "search",
    "meta",
    "streams"
  ],
  "languages": [
    "Latino",
    "Subtitulado"
  ],
  "episodesPagination": {
    "enabled": true,
    "perPage": 50
  },
  "config": [
    {
      "key": "idioma",
      "label": "Idioma",
      "type": "select",
      "default": "Latino, o subtitulado si no hay",
      "options": [
        "Solo latino",
        "Latino, o subtitulado si no hay",
        "Solo subtitulado"
      ]
    },
    {
      "key": "servidor",
      "label": "Servidor preferido",
      "type": "select",
      "default": "Voe (720p, funciona en TV)",
      "options": [
        "Voe (720p, funciona en TV)",
        "UPNShare (hasta 1080p, funciona en TV)",
        "MP4Upload (1080p AV1, celular)",
        "YourUpload (mp4)",
        "StreamTape (mp4)"
      ]
    }
  ],
  "newsImageStyle": "poster"
}
