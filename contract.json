{
  "apiVersion": 6,
  "maxApiVersion": 6,
  "capabilities": {
    "names": [
      "home",
      "search",
      "discover",
      "meta",
      "streams",
      "catalogs"
    ],
    "required": [
      "streams"
    ],
    "atLeastOneOf": [
      "search",
      "home"
    ]
  },
  "manifest": {
    "idPattern": "^[a-z0-9][a-z0-9-]{1,39}$",
    "nameMaxChars": 40
  }
}